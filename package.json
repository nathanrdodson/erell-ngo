{
  "name": "erell-ghost-theme",
  "description": "Custom Ghost theme for Erell Institute — warm desert design",
  "version": "1.0.0",
  "engines": {
    "ghost": ">=5.0.0"
  },
  "license": "MIT",
  "keywords": [
    "ghost-theme"
  ],
  "config": {
    "posts_per_page": 10,
    "image_sizes": {}
  },
  "devDependencies": {
    "sass": "^1.70.0"
  },
  "scripts": {
    "build:css": "sass assets/css/src/main.scss assets/css/screen.css --style=compressed --no-source-map"
  }
}
