{{!< default}}

<main class="page-main">
  <div class="pure-g center">
    <div class="pure-u-1 pure-u-md-4-5 pure-u-lg-3-5 pure-u-xxl-1-2">

      <header class="page-header">
        <h1>{{title}}</h1>
        {{#if custom_excerpt}}<p class="page-header__lead">{{custom_excerpt}}</p>{{/if}}
      </header>

      <h2 class="section-title">Newsletters &amp; Field Updates</h2>

      {{#get "posts" filter="tag:newsletter" limit="all"}}
      <div class="archive-feed">
        {{#foreach posts}}
        <article class="archive-entry{{#if feature_image}} archive-entry--img{{/if}} fade-up">
          {{#if feature_image}}
          <img src="{{feature_image}}" alt="{{title}}" class="archive-entry__img" />
          {{/if}}
          <div class="archive-entry__content">
            <div class="archive-entry__eyebrow">{{date published_at format="MMMM YYYY"}}</div>
            <h2 class="archive-entry__title"><a href="{{url}}">{{title}}</a></h2>
            {{#if excerpt}}<div class="archive-entry__body"><p>{{excerpt}}</p></div>{{/if}}
            <a href="{{url}}" class="archive-entry__pdf">Read more &rarr;</a>
          </div>
        </article>
        {{/foreach}}
      </div>
      {{/get}}

      {{#if content}}
      <div class="post-content">
        {{content}}
      </div>
      {{/if}}

    </div>
  </div>
</main>
