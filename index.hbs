{{!< default}}

<!-- Hero -->
<section class="hero">
  <img src="{{asset "images/main-banner.jpg"}}" alt="Erell Institute field research in the Chihuahuan Desert" class="hero__img" />
  <div class="hero__overlay">
    <div class="hero__tagline">Erell Institute &middot; Est. 2017 &middot; Behavioral Ecology</div>
    <h1 class="hero__title">Education Through Research</h1>
    <p class="hero__mission">
      We develop the curiosity and creativity of the next generation of field scientists — through research experiences that welcome people from all backgrounds into the process of science.
    </p>
    <div class="hero__ctas">
      <a href="/education/" class="hero__cta hero__cta--filled">Our Programs</a>
      <a href="/about/" class="hero__cta">Our Mission</a>
    </div>
  </div>
  <a href="#upcoming" class="hero__scroll" aria-label="Scroll down">
    <i class="iconoir-nav-arrow-down"></i>
  </a>
</section>

<!-- Upcoming projects -->
<div id="upcoming" class="upcoming fade-up">
  <div class="upcoming__label">Upcoming Field Research</div>
  <div class="upcoming__projects">
    <div class="upcoming__project">
      <strong>Collaborative Research — Baja California Sur, Mexico</strong>
      <span>March 2026</span>
    </div>
    <div class="upcoming__project">
      <strong>Collaborative Research — Chaco, Paraguay</strong>
      <span>Coming soon</span>
    </div>
  </div>
</div>

<!-- Pillar cards -->
<section class="pillars">
  <div class="pillars__header fade-up">
    <h2>Science is learned by doing it.</h2>
    <p>Each expedition brings a team of diverse researchers together to develop a question, collect data, and present their findings — to each other, and to the world.</p>
  </div>
  <div class="pillars__grid">
    <div class="pillar-card fade-up" data-num="1">
      <div class="pillar-card__eyebrow">Program &middot; 01</div>
      <h3>Education</h3>
      <p>
        Hands-on research in desert ecosystems teaches participants what it means to actually be a scientist — not through textbooks, but through live questions, real data, and honest uncertainty.
      </p>
      <a href="/education/" class="pillar-card__link">Explore programs &rarr;</a>
    </div>
    <div class="pillar-card fade-up" data-num="2">
      <div class="pillar-card__eyebrow">Program &middot; 02</div>
      <h3>Research</h3>
      <p>
        Our research spans social systems and movement ecology. Every expedition generates publishable data — and every participant contributes to it, regardless of background.
      </p>
      <a href="/research/" class="pillar-card__link">Explore research &rarr;</a>
    </div>
    <div class="pillar-card fade-up" data-num="3">
      <div class="pillar-card__eyebrow">Program &middot; 03</div>
      <h3>Support</h3>
      <p>
        We are a 501(c)(3) non-profit. Your support keeps expeditions accessible to researchers from all walks of life.
      </p>
      <a href="/support/" class="pillar-card__link">Support our work &rarr;</a>
    </div>
  </div>
</section>

<!-- NETP Callout -->
<section class="netp-callout">
  <div class="netp-callout__inner fade-up">
    <div class="netp-callout__content">
      <div class="netp-callout__label">NETP — Naturalist-Ecologist Training Program</div>
      <h2>Training the next generation of field scientists</h2>
      <p>
        Developing curiosity and creativity in young researchers while they determine their next steps in science — through real expeditions, real data, and real uncertainty in the field.
      </p>
      <a href="/education/netp/">Learn more about NETP &rarr;</a>
    </div>
    <div class="netp-callout__visual">
      <div class="netp-callout__stat">
        <strong>2017</strong>
        <span>Est. field research</span>
      </div>
      <div class="netp-callout__stat netp-callout__stat--accent">
        <strong>340+</strong>
        <span>Species recorded</span>
      </div>
      <div class="netp-callout__stat netp-callout__stat--accent">
        <strong>4</strong>
        <span>Continents active</span>
      </div>
      <div class="netp-callout__stat">
        <strong>12+</strong>
        <span>Expeditions to date</span>
      </div>
    </div>
  </div>
</section>

<!-- Lizard Camp Feature -->
<section class="program-feature">
  <div class="program-feature__inner">
    <div class="program-feature__photo">
      <img src="{{asset "images/lizard-camp/2025.jpg"}}" alt="Lizard Camp 2025 — Chihuahuan Desert, Texas" />
      <div class="program-feature__badge">Lizard Camp 2025 &middot; Chihuahuan Desert, Texas</div>
    </div>
    <div class="program-feature__content fade-up">
      <div class="program-feature__label">Our Flagship Program</div>
      <h2>Lizard Camp</h2>
      <p>
        Using hands on learning in desert ecosystems to teach students how to be a scientist!
      </p>
      <a href="/education/lizard-camp/" class="program-feature__link">Explore Lizard Camp</a>
    </div>
  </div>
</section>

<!-- Photo Break -->
<section class="photo-break">
  <img src="{{asset "images/photos/collared-lizard.jpg"}}" alt="Collared Lizard" class="photo-break__img" />
  <div class="photo-break__quote">
    <p>Every desert holds a story — we help people read it.</p>
  </div>
</section>

<!-- Where We Work -->
<section class="field-sites fade-up">
  <div class="pure-g center">
    <div class="pure-u-1 pure-u-md-4-5 pure-u-lg-4-5 pure-u-xxl-3-5">
      <div class="field-sites__heading">
        <h2>Where We Work</h2>
        <p>Field sites spanning four continents, from the Gobi to the Chihuahuan Desert.</p>
      </div>
      <div class="field-sites__photos">
        <div class="field-sites__photo-item">
          <img src="{{asset "images/photos/site-chihuahua-desert-colorado.jpg"}}" alt="Chihuahuan Desert, Colorado" loading="lazy" />
          <div class="field-sites__photo-item__label">Chihuahuan Desert</div>
        </div>
        <div class="field-sites__photo-item">
          <img src="{{asset "images/photos/site-great-basin-desert-oregon.jpg"}}" alt="Great Basin Desert, Oregon" loading="lazy" />
          <div class="field-sites__photo-item__label">Great Basin Desert</div>
        </div>
        <div class="field-sites__photo-item">
          <img src="{{asset "images/photos/site-chiricahua-mountains-arizona.jpg"}}" alt="Chiricahua Mountains, Arizona" loading="lazy" />
          <div class="field-sites__photo-item__label">Chiricahua Mountains</div>
        </div>
        <div class="field-sites__photo-item">
          <img src="{{asset "images/photos/site-wichita-mountains-oklahoma.jpg"}}" alt="Wichita Mountains, Oklahoma" loading="lazy" />
          <div class="field-sites__photo-item__label">Wichita Mountains</div>
        </div>
        <div class="field-sites__photo-item">
          <img src="{{asset "images/photos/site-kino-bay-mexico.jpg"}}" alt="Kino Bay, Mexico" loading="lazy" />
          <div class="field-sites__photo-item__label">Kino Bay, Mexico</div>
        </div>
        <div class="field-sites__photo-item">
          <img src="{{asset "images/photos/site-sierra-la-laguna-baja.jpg"}}" alt="Sierra La Laguna, Baja" loading="lazy" />
          <div class="field-sites__photo-item__label">Sierra La Laguna</div>
        </div>
        <div class="field-sites__photo-item">
          <img src="{{asset "images/photos/site-namib-desert.jpg"}}" alt="Namib Desert, Namibia" loading="lazy" />
          <div class="field-sites__photo-item__label">Namib Desert</div>
        </div>
        <div class="field-sites__photo-item">
          <img src="{{asset "images/photos/site-kalahari-desert-botswana.jpg"}}" alt="Kalahari, Botswana" loading="lazy" />
          <div class="field-sites__photo-item__label">Kalahari Desert</div>
        </div>
        <div class="field-sites__photo-item">
          <img src="{{asset "images/photos/site-little-scrub-island-anguilla.jpg"}}" alt="Little Scrub Island, Anguilla" loading="lazy" />
          <div class="field-sites__photo-item__label">Little Scrub Island</div>
        </div>
        <div class="field-sites__photo-item">
          <img src="{{asset "images/photos/site-atacama-chile.jpg"}}" alt="Atacama Desert, Chile" loading="lazy" />
          <div class="field-sites__photo-item__label">Atacama Desert</div>
        </div>
        <div class="field-sites__photo-item">
          <img src="{{asset "images/photos/site-gobi-desert-mongolia.jpg"}}" alt="Gobi Desert, Mongolia" loading="lazy" />
          <div class="field-sites__photo-item__label">Gobi Desert</div>
        </div>
      </div>
      <div class="pure-g">
        <div class="pure-u-1 pure-u-sm-1-2 pure-u-md-1-4">
          <div class="field-sites__region">
            <div class="field-sites__region-name">North America</div>
            <ul class="field-sites__sites">
              <li>Chihuahuan Desert, Texas &amp; Colorado</li>
              <li>Great Basin Desert, Oregon</li>
              <li>Guadalupe Mountains, Texas</li>
              <li>Douglas County, Kansas</li>
              <li>Baja California Sur, Mexico <em>upcoming</em></li>
            </ul>
          </div>
        </div>
        <div class="pure-u-1 pure-u-sm-1-2 pure-u-md-1-4">
          <div class="field-sites__region">
            <div class="field-sites__region-name">Africa</div>
            <ul class="field-sites__sites">
              <li>Bouhedma National Park, Tunisia</li>
              <li>Namib Desert, Namibia</li>
            </ul>
          </div>
        </div>
        <div class="pure-u-1 pure-u-sm-1-2 pure-u-md-1-4">
          <div class="field-sites__region">
            <div class="field-sites__region-name">Central Asia</div>
            <ul class="field-sites__sites">
              <li>Gobi Desert, Mongolia</li>
            </ul>
          </div>
        </div>
        <div class="pure-u-1 pure-u-sm-1-2 pure-u-md-1-4">
          <div class="field-sites__region">
            <div class="field-sites__region-name">Caribbean &amp; South America</div>
            <ul class="field-sites__sites">
              <li>Little Scrub Island, British Virgin Islands</li>
              <li>Dominica</li>
              <li>Chaco, Paraguay <em>upcoming</em></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Image Strip -->
<section class="image-strip">
  <div class="image-strip__grid">
    <div class="image-strip__item">
      <img src="{{asset "images/homepage/CURIOSITY.jpg"}}" alt="Curiosity" loading="lazy" />
      <div class="image-strip__item__label">Curiosity</div>
    </div>
    <div class="image-strip__item">
      <img src="{{asset "images/homepage/CREATIVITY.jpg"}}" alt="Creativity" loading="lazy" />
      <div class="image-strip__item__label">Creativity</div>
    </div>
    <div class="image-strip__item">
      <img src="{{asset "images/homepage/TEAMWORK.jpg"}}" alt="Teamwork" loading="lazy" />
      <div class="image-strip__item__label">Teamwork</div>
    </div>
    <div class="image-strip__item">
      <img src="{{asset "images/homepage/DISCOVERY.jpg"}}" alt="Discovery" loading="lazy" />
      <div class="image-strip__item__label">Discovery</div>
    </div>
    <div class="image-strip__item">
      <img src="{{asset "images/homepage/RESEARCH.jpg"}}" alt="Research" loading="lazy" />
      <div class="image-strip__item__label">Research</div>
    </div>
    <div class="image-strip__item">
      <img src="{{asset "images/homepage/support-erell.jpg"}}" alt="Support Erell Institute" loading="lazy" />
      <div class="image-strip__item__label">Support</div>
    </div>
  </div>
</section>

<!-- Newsletter strip -->
<div class="newsletter-strip fade-up">
  <p class="newsletter-strip__archive">Looking for previous newsletters or announcements? <a href="/about/newsletter-archive/">Access the archive</a></p>
  <h2>Stay Connected</h2>
  <p>Field updates, research results, and upcoming expeditions — delivered to your inbox.</p>
  <a href="/about/newsletter-archive/" class="newsletter-link">Read the Newsletter</a>
</div>

{{#if @blog.posts}}
<section class="page-main">
  <div class="pure-g center">
    <div class="pure-u-1 pure-u-md-4-5">
      <h2 class="section-title">Latest from the Blog</h2>
      <div class="post-feed">
        {{#foreach posts}}
        <article class="post-card fade-up">
          {{#if feature_image}}
          <div class="post-card__img-wrap">
            <img src="{{feature_image}}" alt="{{title}}" class="post-card__img" loading="lazy" />
          </div>
          {{/if}}
          <div class="post-card__body">
            <div class="post-card__meta">{{date published_at format="MMM D, YYYY"}}</div>
            <h3 class="post-card__title">{{title}}</h3>
            {{#if excerpt}}<p class="post-card__excerpt">{{excerpt}}</p>{{/if}}
            <a href="{{url}}" class="post-card__link">Read more &rarr;</a>
          </div>
        </article>
        {{/foreach}}
      </div>
    </div>
  </div>
</section>
{{/if}}
