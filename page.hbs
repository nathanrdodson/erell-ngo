{{!< default}}

{{#post}}
<main class="page-main">
  {{#if feature_image}}
  <div class="page-feature-img">
    <img src="{{feature_image}}" alt="{{title}}" />
  </div>
  {{/if}}
  <div class="pure-g center">
    <div class="pure-u-1 pure-u-md-4-5 pure-u-lg-3-5 pure-u-xxl-1-2">
      <header class="page-header">
        <h1>{{title}}</h1>
        {{#if custom_excerpt}}<p class="page-header__lead">{{custom_excerpt}}</p>{{/if}}
      </header>
      <div class="post-content">
        {{content}}
      </div>
    </div>
  </div>
</main>
{{/post}}
