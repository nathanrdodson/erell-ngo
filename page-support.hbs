{{!< default}}

{{#post}}
<main class="page-main">
  <div class="pure-g center">
    <div class="pure-u-1 pure-u-md-4-5 pure-u-lg-3-5 pure-u-xxl-1-2">
      <header class="page-header">
        <h1>{{title}}</h1>
        {{#if custom_excerpt}}<p class="page-header__lead">{{custom_excerpt}}</p>{{/if}}
      </header>
      <div class="post-content">
        {{content}}
      </div>
      <div class="paypal-wrap">
        <script src="https://www.paypal.com/sdk/js?client-id=BAAF8gY-rlR6onQGMeRNLfnlOrwSNJVeXlGS43129g-S6JewYGNPwGwkRBSyV8q_RLKcglm4jyUXbBraH8&components=hosted-buttons&enable-funding=venmo&currency=USD"></script>
        <div id="paypal-container-HLXSZPC9359X8"></div>
        <script>
          paypal.HostedButtons({
            hostedButtonId: "HLXSZPC9359X8",
          }).render("#paypal-container-HLXSZPC9359X8");
        </script>
      </div>
      <p class="tax-note">Erell Institute is a registered 501(c)(3). Donations are tax-deductible to the extent permitted by law.</p>
    </div>
  </div>
</main>
{{/post}}
