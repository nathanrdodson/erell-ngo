---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import imgCollared     from '../assets/img/photos/collared-lizard.jpg';
import imgDesertHorned from '../assets/img/photos/desert-horned-lizard-juvenile.jpg';
import imgNamibGecko   from '../assets/img/photos/namib-day-gecko.jpg';
import imgRedTegu      from '../assets/img/photos/red-tegu.jpg';
import imgBajaRock     from '../assets/img/photos/baja-california-rock-lizard.jpg';
import imgGroundAgama  from '../assets/img/photos/ground-agama.jpg';
import imgCamp2025     from '../assets/img/lizard-camp/2025.jpg';
import imgCamp2023     from '../assets/img/lizard-camp/2023.jpg';
import imgCamp2022     from '../assets/img/lizard-camp/2022.jpg';
import imgGobi         from '../assets/img/photos/site-gobi-desert-mongolia.jpg';
import mainBanner      from '../assets/img/main-banner.jpg';
---
<style lang="scss">
@use '../assets/css/_theme.scss' as *;
@use '../assets/css/_mixins.scss' as *;

.brand-page {
	padding: 64px 24px 96px;
	max-width: 1100px;
	margin: 0 auto;
}

.brand-section {
	margin-bottom: 72px;

	&__title {
		font-family: "indivisible", sans-serif;
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		color: $green-mid;
		margin-bottom: 28px;
		padding-bottom: 12px;
		border-bottom: 1px solid $border-subtle;
	}
}

// ─────────────────────────────────────────────
// Color swatches
// ─────────────────────────────────────────────

.swatches {
	display: flex;
	flex-wrap: wrap;
	gap: 16px;
}

.swatch {
	width: 120px;

	&__block {
		height: 80px;
		border: 1px solid rgba(0,0,0,0.07);
		margin-bottom: 10px;
	}

	&__name {
		font-family: "indivisible", sans-serif;
		font-size: 9.5px;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: $font-mid;
		display: block;
		margin-bottom: 3px;
	}

	&__hex {
		font-family: "indivisible", sans-serif;
		font-size: 11px;
		color: $font-light;
		display: block;
	}
}

// ─────────────────────────────────────────────
// Typography samples
// ─────────────────────────────────────────────

.type-samples {
	display: flex;
	flex-direction: column;
	gap: 32px;
}

.type-row {
	display: flex;
	align-items: baseline;
	gap: 32px;
	flex-wrap: wrap;

	&__label {
		font-family: "indivisible", sans-serif;
		font-size: 9px;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: $font-light;
		width: 120px;
		flex-shrink: 0;
	}

	&__sample {
		flex: 1;
	}
}

// ─────────────────────────────────────────────
// Buttons
// ─────────────────────────────────────────────

.button-row {
	display: flex;
	flex-wrap: wrap;
	gap: 16px;
	align-items: center;
}

.btn-dark-bg {
	background: $green-dark;
	padding: 32px 40px;
	display: flex;
	gap: 16px;
	align-items: center;
	flex-wrap: wrap;
}

.btn-outline-light {
	display: inline-block;
	color: #F7F3EE;
	border: 1px solid rgba(247, 243, 238, 0.6);
	padding: 13px 36px;
	font-family: "indivisible", sans-serif;
	font-size: 11px;
	text-transform: uppercase;
	letter-spacing: 0.1em;
	text-decoration: none;
	transition: background 0.25s ease, border-color 0.25s ease;
	cursor: pointer;
	background: transparent;

	&:hover {
		background: rgba(247, 243, 238, 0.18);
		border-color: rgba(247, 243, 238, 0.9);
		color: #F7F3EE;
	}
}

.btn-filled-light {
	display: inline-block;
	color: #F7F3EE;
	background: rgba(247, 243, 238, 0.15);
	border: 1px solid rgba(247, 243, 238, 0.7);
	padding: 13px 36px;
	font-family: "indivisible", sans-serif;
	font-size: 11px;
	text-transform: uppercase;
	letter-spacing: 0.1em;
	text-decoration: none;
	transition: background 0.25s ease, border-color 0.25s ease;
	cursor: pointer;

	&:hover {
		background: rgba(247, 243, 238, 0.28);
		border-color: #F7F3EE;
		color: #F7F3EE;
	}
}

.btn-outline-dark {
	display: inline-block;
	color: $green-dark;
	border: 1px solid $green-dark;
	padding: 13px 36px;
	font-family: "indivisible", sans-serif;
	font-size: 11px;
	text-transform: uppercase;
	letter-spacing: 0.1em;
	text-decoration: none;
	background: transparent;
	transition: background 0.22s ease, color 0.22s ease;
	cursor: pointer;

	&:hover {
		background: $green-dark;
		color: $text-on-green;
	}
}

.btn-filled-dark {
	display: inline-block;
	color: $text-on-green;
	background: $green-dark;
	border: 1px solid $green-dark;
	padding: 13px 36px;
	font-family: "indivisible", sans-serif;
	font-size: 11px;
	text-transform: uppercase;
	letter-spacing: 0.1em;
	text-decoration: none;
	cursor: pointer;
}

// ─────────────────────────────────────────────
// Pillar card sample
// ─────────────────────────────────────────────

.card-sample {
	max-width: 280px;
	padding: 40px 28px;
	border: 1px solid $border-subtle;
	background: $secondary;
	text-align: center;
	display: flex;
	flex-direction: column;

	.card-icon {
		font-size: 48px;
		color: $green-light;
		display: block;
		margin-bottom: 20px;
	}

	h3 {
		font-size: 1.1rem;
		margin-bottom: 12px;
		color: $green-dark;
	}

	p {
		font-size: 0.88rem;
		line-height: 1.75;
		color: $font-mid;
		margin-bottom: 24px;
		flex: 1;
	}

	.card-link {
		font-family: "indivisible", sans-serif;
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: $green-dark;
		text-decoration: none;
		border-bottom: 1px solid $green-light;
		padding-bottom: 2px;
		align-self: center;
	}
}

// ─────────────────────────────────────────────
// Photo grid
// ─────────────────────────────────────────────

.photo-grid {
	display: grid;
	grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
	gap: 4px;

	@include respond-to('small-mx') {
		grid-template-columns: repeat(2, 1fr);
	}
}

.photo-item {
	position: relative;
	overflow: hidden;
	height: 300px;

	img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		display: block;
	}

	&__cap {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		padding: 28px 14px 10px;
		background: linear-gradient(to top, rgba(44,36,22,0.65) 0%, transparent 100%);
		font-family: "indivisible", sans-serif;
		font-size: 9px;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: rgba(247, 243, 238, 0.85);
	}
}

// ─────────────────────────────────────────────
// Overlay / texture samples
// ─────────────────────────────────────────────

.overlay-samples {
	display: flex;
	gap: 12px;
	flex-wrap: wrap;
}

.overlay-sample {
	position: relative;
	width: 220px;
	height: 140px;
	overflow: hidden;

	img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	&__overlay {
		position: absolute;
		inset: 0;
	}

	&__label {
		position: absolute;
		bottom: 10px;
		left: 12px;
		font-family: "indivisible", sans-serif;
		font-size: 9px;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: rgba(247, 243, 238, 0.85);
	}
}

// ─────────────────────────────────────────────
// Green as structure
// ─────────────────────────────────────────────

.green-structure-demo {
	display: flex;
	gap: 16px;
	flex-wrap: wrap;
}

.green-block {
	flex: 1;
	min-width: 280px;
	background: $green-dark;
	padding: 32px 40px;

	&__label {
		font-family: "indivisible", sans-serif;
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		color: rgba(247, 243, 238, 0.45);
		margin-bottom: 20px;
	}

	&__sites {
		display: flex;
		flex-direction: column;
		gap: 16px;

		div {
			strong {
				display: block;
				font-family: "apparat-light", sans-serif;
				font-size: 0.95rem;
				color: $text-on-green;
				font-weight: 300;
				margin-bottom: 4px;
			}
			span {
				font-family: "indivisible", sans-serif;
				font-size: 10px;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				color: rgba(247, 243, 238, 0.42);
			}
		}
	}
}

.green-callout {
	flex: 1;
	min-width: 280px;
	background: $green-dark;
	padding: 40px 44px;
	display: flex;
	flex-direction: column;
	justify-content: center;

	&__label {
		font-family: "indivisible", sans-serif;
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: $green-light;
		margin-bottom: 16px;
	}

	p {
		font-family: "apparat-light", sans-serif;
		font-size: 1.3rem;
		line-height: 1.5;
		color: $text-on-green;
		margin: 0;
		letter-spacing: -0.01em;
		font-weight: 300;
	}
}

// ─────────────────────────────────────────────
// Brand voice
// ─────────────────────────────────────────────

.brand-voice {
	background: $secondary;
	border: 1px solid $border-subtle;
	padding: 48px 52px;
	max-width: 680px;

	p {
		font-size: 1.1rem;
		line-height: 1.8;
		color: $font-mid;
		margin-bottom: 18px;

		&:last-child { margin-bottom: 0; }
	}

	strong {
		color: $green-dark;
		font-weight: 400;
	}
}
</style>

<Layout title="Brand Reference" description="Visual identity reference for the Erell Institute website.">
<div class="brand-page">

	<div style="margin-bottom: 56px;">
		<h1 style="margin-bottom: 8px;">Brand Reference</h1>
		<p style="color: var(--font-light, #6B5840); font-size: 0.9rem;">Visual identity reference for the Erell Institute website. Use this page to discuss colors, typography, photography direction, and overall feel.</p>
	</div>

	<!-- Colors -->
	<section class="brand-section">
		<div class="brand-section__title">Color Palette</div>
		<div class="swatches">
			<div class="swatch">
				<div class="swatch__block" style="background: #F9F7F4;"></div>
				<span class="swatch__name">Primary</span>
				<span class="swatch__hex">#F9F7F4 — page background</span>
			</div>
			<div class="swatch">
				<div class="swatch__block" style="background: #EEEBE4;"></div>
				<span class="swatch__name">Secondary</span>
				<span class="swatch__hex">#EEEBE4 — cards, nav</span>
			</div>
			<div class="swatch">
				<div class="swatch__block" style="background: #E2DDD3;"></div>
				<span class="swatch__name">Surface</span>
				<span class="swatch__hex">#E2DDD3 — dividers, hover</span>
			</div>
			<div class="swatch">
				<div class="swatch__block" style="background: #233D25;"></div>
				<span class="swatch__name">Green Dark</span>
				<span class="swatch__hex">#233D25 — headings, CTAs</span>
			</div>
			<div class="swatch">
				<div class="swatch__block" style="background: #4E7550;"></div>
				<span class="swatch__name">Green Mid</span>
				<span class="swatch__hex">#4E7550 — accents, hover</span>
			</div>
			<div class="swatch">
				<div class="swatch__block" style="background: #89B08C;"></div>
				<span class="swatch__name">Green Light</span>
				<span class="swatch__hex">#89B08C — tags, highlights</span>
			</div>
			<div class="swatch">
				<div class="swatch__block" style="background: #B5642A;"></div>
				<span class="swatch__name">Earth Brown</span>
				<span class="swatch__hex">#B5642A — accent links</span>
			</div>
			<div class="swatch">
				<div class="swatch__block" style="background: #D4915C;"></div>
				<span class="swatch__name">Earth Warm</span>
				<span class="swatch__hex">#D4915C — CTA hover</span>
			</div>
			<div class="swatch">
				<div class="swatch__block" style="background: #141210;"></div>
				<span class="swatch__name">Font Dark</span>
				<span class="swatch__hex">#141210 — primary text</span>
			</div>
			<div class="swatch">
				<div class="swatch__block" style="background: #352A1C;"></div>
				<span class="swatch__name">Font Mid</span>
				<span class="swatch__hex">#352A1C — body text</span>
			</div>
			<div class="swatch">
				<div class="swatch__block" style="background: #6B5840;"></div>
				<span class="swatch__name">Font Light</span>
				<span class="swatch__hex">#6B5840 — captions, meta</span>
			</div>
			<div class="swatch">
				<div class="swatch__block" style="background: #D5CEBF;"></div>
				<span class="swatch__name">Border Subtle</span>
				<span class="swatch__hex">#D5CEBF — borders</span>
			</div>
		</div>
	</section>

	<!-- Typography -->
	<section class="brand-section">
		<div class="brand-section__title">Typography</div>
		<div class="type-samples">
			<div class="type-row">
				<span class="type-row__label">H1 — Apparat Light 2.8rem</span>
				<div class="type-row__sample"><h1 style="margin:0;">Education Through Research</h1></div>
			</div>
			<div class="type-row">
				<span class="type-row__label">H2 — Apparat Light 1.9rem</span>
				<div class="type-row__sample"><h2 style="margin:0;">Naturalist-Ecologist Training Program</h2></div>
			</div>
			<div class="type-row">
				<span class="type-row__label">H3 — Apparat Light 1.3rem</span>
				<div class="type-row__sample"><h3 style="margin:0;">Lizard Camp</h3></div>
			</div>
			<div class="type-row">
				<span class="type-row__label">Body — 0.93rem / 1.8lh</span>
				<div class="type-row__sample">
					<p style="margin:0; font-size: 0.93rem; line-height: 1.8;">We organize research experiences that enable people from all backgrounds to take part in the process of science. Participants develop real scientific skills while working alongside faculty researchers in some of the world's most striking desert ecosystems.</p>
				</div>
			</div>
			<div class="type-row">
				<span class="type-row__label">Label — Indivisible 11px caps</span>
				<div class="type-row__sample">
					<span style="font-family: 'indivisible', sans-serif; font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: #4E7550;">Our Flagship Program</span>
				</div>
			</div>
			<div class="type-row">
				<span class="type-row__label">Caption — Indivisible 9px caps</span>
				<div class="type-row__sample">
					<span style="font-family: 'indivisible', sans-serif; font-size: 9px; text-transform: uppercase; letter-spacing: 0.14em; color: #6B5840;">Lizard Camp 2025 · Chihuahuan Desert, Texas</span>
				</div>
			</div>
		</div>
	</section>

	<!-- Buttons -->
	<section class="brand-section">
		<div class="brand-section__title">Buttons</div>
		<div style="display: flex; flex-direction: column; gap: 16px;">
			<div class="btn-dark-bg">
				<a class="btn-outline-light" href="#">Our Mission</a>
				<a class="btn-filled-light" href="#">Our Programs</a>
			</div>
			<div class="button-row">
				<a class="btn-outline-dark" href="#">Explore Lizard Camp</a>
				<a class="btn-filled-dark" href="#">Filled Dark</a>
			</div>
		</div>
	</section>

	<!-- Cards -->
	<section class="brand-section">
		<div class="brand-section__title">Card Component</div>
		<div class="card-sample">
			<i class="iconoir-graduation-cap card-icon"></i>
			<h3>Education</h3>
			<p>Using hands on learning in desert ecosystems to teach students how to be a scientist.</p>
			<a href="#" class="card-link">Explore programs</a>
		</div>
	</section>

	<!-- Photography -->
	<section class="brand-section">
		<div class="brand-section__title">Photography Direction</div>
		<p style="font-size: 0.88rem; color: #6B5840; margin-bottom: 20px; max-width: 60ch;">The photography is the emotional engine of the site. It should feel close, specific, and scientific — not stock. Close-up species portraits, field work candids, and dramatic landscape shots all work well together.</p>
		<div class="photo-grid">
			<div class="photo-item">
				<Image src={imgCollared} alt="Collared Lizard" width={400} />
				<div class="photo-item__cap">Species portrait</div>
			</div>
			<div class="photo-item">
				<Image src={imgDesertHorned} alt="Desert Horned Lizard" width={400} loading="lazy" />
				<div class="photo-item__cap">Species portrait</div>
			</div>
			<div class="photo-item">
				<Image src={imgNamibGecko} alt="Namib Day Gecko" width={400} loading="lazy" />
				<div class="photo-item__cap">Species portrait</div>
			</div>
			<div class="photo-item">
				<Image src={imgRedTegu} alt="Red Tegu" width={400} loading="lazy" />
				<div class="photo-item__cap">Species portrait</div>
			</div>
			<div class="photo-item">
				<Image src={imgCamp2025} alt="Lizard Camp 2025" width={400} loading="lazy" />
				<div class="photo-item__cap">Field work candid</div>
			</div>
			<div class="photo-item">
				<Image src={imgCamp2023} alt="Lizard Camp 2023" width={400} loading="lazy" />
				<div class="photo-item__cap">Field work candid</div>
			</div>
			<div class="photo-item">
				<Image src={imgGobi} alt="Gobi Desert, Mongolia" width={400} loading="lazy" />
				<div class="photo-item__cap">Landscape / field site</div>
			</div>
			<div class="photo-item">
				<Image src={imgBajaRock} alt="Baja California Rock Lizard" width={400} loading="lazy" />
				<div class="photo-item__cap">Species portrait</div>
			</div>
			<div class="photo-item">
				<Image src={imgGroundAgama} alt="Ground Agama" width={400} loading="lazy" />
				<div class="photo-item__cap">Species portrait</div>
			</div>
			<div class="photo-item">
				<Image src={imgCamp2022} alt="Lizard Camp 2022" width={400} loading="lazy" />
				<div class="photo-item__cap">Field work candid</div>
			</div>
		</div>
	</section>

	<!-- Overlay / Texture -->
	<section class="brand-section">
		<div class="brand-section__title">Overlay Treatments</div>
		<p style="font-size: 0.88rem; color: #6B5840; margin-bottom: 20px; max-width: 60ch;">Dark linear gradients overlay photos to ensure text legibility while keeping the image visible. Three intensity levels are used across the site.</p>
		<div class="overlay-samples">
			<div class="overlay-sample">
				<Image src={mainBanner} alt="" width={440} />
				<div class="overlay-sample__overlay" style="background: linear-gradient(to bottom, rgba(44,36,22,0.20) 0%, rgba(44,36,22,0.48) 100%);"></div>
				<span class="overlay-sample__label">Hero (light)</span>
			</div>
			<div class="overlay-sample">
				<Image src={mainBanner} alt="" width={440} />
				<div class="overlay-sample__overlay" style="background: linear-gradient(to top, rgba(44,36,22,0.72) 0%, transparent 100%);"></div>
				<span class="overlay-sample__label">Badge (bottom-up)</span>
			</div>
			<div class="overlay-sample">
				<Image src={mainBanner} alt="" width={440} />
				<div class="overlay-sample__overlay" style="background: linear-gradient(to bottom, rgba(44,36,22,0.08) 0%, rgba(44,36,22,0.42) 100%);"></div>
				<span class="overlay-sample__label">Photo break (subtle)</span>
			</div>
		</div>
	</section>

	<!-- Green as structure -->
	<section class="brand-section">
		<div class="brand-section__title">Green as Structure</div>
		<p style="font-size: 0.88rem; color: #6B5840; margin-bottom: 20px; max-width: 60ch;">The dark green earns structural use — as section backgrounds and key callouts, not just as a text or accent color. When green fills a block, it commands attention without decoration.</p>
		<div class="green-structure-demo">
			<div class="green-block">
				<div class="green-block__label">Upcoming Field Research</div>
				<div class="green-block__sites">
					<div>
						<strong>Collaborative Research — Baja California Sur</strong>
						<span>March 2026</span>
					</div>
					<div>
						<strong>Collaborative Research — Chaco, Paraguay</strong>
						<span>Coming soon</span>
					</div>
				</div>
			</div>
			<div class="green-callout">
				<div class="green-callout__label">The bottom line</div>
				<p>Restraint lives in the weight, not the scale. Use Apparat Light large and unafraid — the lightness of the typeface is the restraint.</p>
			</div>
		</div>
	</section>

	<!-- Brand Voice -->
	<section class="brand-section">
		<div class="brand-section__title">Brand Voice & Visual Identity</div>
		<div class="brand-voice">
			<p><strong>The visual identity is warm, nature-grounded, and understated — never timid.</strong> The palette draws from the desert — ochres, sages, off-whites. It reads as scientific but approachable, never clinical.</p>
			<p>The photography does the emotional work. Close-up lizard portraits, field-work candids, and wide desert landscapes all serve the brand — they communicate that this is real science happening in real, beautiful places. Give photography room to breathe; don't shrink it into cautious grids.</p>
			<p>Typography is light and precise: Apparat Light for everything display and editorial, Indivisible for all UI labels and caps-lock text. No bold weights — the restraint lives in the weight, not the scale. Display headings should be large and unafraid. The dark green (#233D25) earns structural use as section backgrounds and key callouts, not just text color.</p>
			<p><strong>The goal is a site that feels like it was designed by scientists who also care about beauty.</strong></p>
		</div>
	</section>

</div>
</Layout>
