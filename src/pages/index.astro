---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import mainBanner    from '../assets/img/main-banner.jpg';
import campPhoto     from '../assets/img/lizard-camp/2025.jpg';
import imgCuriosity  from '../assets/img/homepage/CURIOSITY.jpg';
import imgCreativity from '../assets/img/homepage/CREATIVITY.jpg';
import imgTeamwork   from '../assets/img/homepage/TEAMWORK.jpg';
import imgDiscovery  from '../assets/img/homepage/DISCOVERY.jpg';
import imgResearch   from '../assets/img/homepage/RESEARCH.jpg';
import imgSupport    from '../assets/img/homepage/support-erell.jpg';
import photoBreak    from '../assets/img/photos/collared-lizard.jpg';
import siteAtacama   from '../assets/img/photos/site-atacama-chile.jpg';
import siteChihuahua from '../assets/img/photos/site-chihuahua-desert-colorado.jpg';
import siteChiricahua from '../assets/img/photos/site-chiricahua-mountains-arizona.jpg';
import siteGobi      from '../assets/img/photos/site-gobi-desert-mongolia.jpg';
import siteGreatBasin from '../assets/img/photos/site-great-basin-desert-oregon.jpg';
import siteKalahari  from '../assets/img/photos/site-kalahari-desert-botswana.jpg';
import siteKinoBay   from '../assets/img/photos/site-kino-bay-mexico.jpg';
import siteLittleScrub from '../assets/img/photos/site-little-scrub-island-anguilla.jpg';
import siteNamib     from '../assets/img/photos/site-namib-desert.jpg';
import siteSierraLaLaguna from '../assets/img/photos/site-sierra-la-laguna-baja.jpg';
import siteWichita   from '../assets/img/photos/site-wichita-mountains-oklahoma.jpg';
const b = import.meta.env.BASE_URL;
---
<style lang="scss">
@use '../assets/css/_theme.scss' as *;
@use '../assets/css/_mixins.scss' as *;

// ─────────────────────────────────────────────
// Hero
// ─────────────────────────────────────────────

@keyframes heroFadeUp {
	from { opacity: 0; transform: translateY(18px); }
	to   { opacity: 1; transform: translateY(0); }
}

@keyframes scrollPulse {
	0%, 100% { opacity: 0.4; transform: translateX(-50%) translateY(0); }
	50%      { opacity: 0.85; transform: translateX(-50%) translateY(7px); }
}

.hero {
	position: relative;
	width: 100%;
	height: 100svh;
	min-height: 580px;
	display: flex;
	align-items: flex-end;
	justify-content: flex-start;
	overflow: hidden;

	@include respond-to('small-mx') {
		min-height: 440px;
		height: 100svh;
	}

	&__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	&::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(
			to bottom,
			rgba(14, 10, 6, 0.10) 0%,
			rgba(14, 10, 6, 0.20) 40%,
			rgba(14, 10, 6, 0.65) 100%
		);
		z-index: 1;
	}

	&__scroll {
		position: absolute;
		bottom: 28px;
		right: 48px;
		z-index: 2;
		color: rgba(247, 243, 238, 0.45);
		font-size: 22px;
		text-decoration: none;
		animation: scrollPulse 2.2s ease-in-out infinite;
		line-height: 1;

		&:hover {
			color: rgba(247, 243, 238, 0.9);
			animation-play-state: paused;
		}
	}

	&__overlay {
		position: relative;
		z-index: 2;
		padding: 0 72px 72px;
		max-width: 900px;
		text-align: left;

		@include respond-to('small-mx') {
			padding: 0 24px 48px;
		}
	}

	&__tagline {
		font-family: "indivisible", sans-serif;
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 0.2em;
		color: rgba(247, 243, 238, 0.6);
		margin-bottom: 20px;
		animation: heroFadeUp 0.8s cubic-bezier(0.4, 0, 0.2, 1) 0.1s both;
	}

	&__title {
		font-family: "apparat-light", sans-serif;
		font-weight: 300;
		color: #F7F3EE;
		font-size: clamp(3.2rem, 7vw, 6.4rem);
		line-height: 1.05;
		margin-bottom: 28px;
		letter-spacing: -0.035em;
		animation: heroFadeUp 0.8s cubic-bezier(0.4, 0, 0.2, 1) 0.22s both;
		text-shadow: 0 2px 32px rgba(14, 10, 6, 0.4);
	}

	&__mission {
		color: rgba(247, 243, 238, 0.82);
		font-size: 1rem;
		line-height: 1.8;
		margin-bottom: 40px;
		max-width: 52ch;
		animation: heroFadeUp 0.8s cubic-bezier(0.4, 0, 0.2, 1) 0.34s both;

		@include respond-to('small-mx') {
			font-size: 0.93rem;
		}
	}

	&__ctas {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
		animation: heroFadeUp 0.8s cubic-bezier(0.4, 0, 0.2, 1) 0.46s both;
	}

	&__cta {
		display: inline-block;
		background: transparent;
		color: #F7F3EE;
		border: 1px solid rgba(247, 243, 238, 0.5);
		padding: 13px 36px;
		font-family: "indivisible", sans-serif;
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		transition: background 0.25s ease, border-color 0.25s ease;

		&:hover {
			background: rgba(247, 243, 238, 0.15);
			border-color: rgba(247, 243, 238, 0.85);
			color: #F7F3EE;
		}

		&--filled {
			background: $green-dark;
			border-color: $green-dark;
			color: $text-on-green;

			&:hover {
				background: $green-mid;
				border-color: $green-mid;
			}
		}
	}
}

// ─────────────────────────────────────────────
// Upcoming projects
// ─────────────────────────────────────────────

.upcoming {
	background: $surface;
	padding: 26px 48px;
	border-bottom: 1px solid $border-subtle;
	display: flex;
	align-items: center;
	gap: 40px;

	@include respond-to('small-mx') {
		flex-direction: column;
		align-items: flex-start;
		gap: 16px;
		padding: 24px;
	}

	&__label {
		font-family: "indivisible", sans-serif;
		font-size: 9px;
		text-transform: uppercase;
		letter-spacing: 0.2em;
		color: $earth-brown;
		white-space: nowrap;
		flex-shrink: 0;
	}

	&__projects {
		display: flex;
		gap: 48px;
		flex-wrap: wrap;

		@include respond-to('small-mx') {
			gap: 16px;
			flex-direction: column;
		}
	}

	&__project {
		strong {
			display: block;
			font-size: 0.85rem;
			color: $font-dark;
			font-weight: 300;
			margin-bottom: 2px;
		}

		span {
			font-size: 0.7rem;
			color: $font-light;
			font-family: "indivisible", sans-serif;
			text-transform: uppercase;
			letter-spacing: 0.1em;
		}
	}
}


// ─────────────────────────────────────────────
// Pillars
// ─────────────────────────────────────────────

.pillars {
	padding: 96px 48px;
	background: $primary;

	@include respond-to('small-mx') {
		padding: 64px 24px;
	}

	&__header {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 64px;
		align-items: end;
		margin-bottom: 52px;
		padding-bottom: 40px;
		border-bottom: 1px solid $border-subtle;

		@media (max-width: 768px) {
			grid-template-columns: 1fr;
			gap: 20px;
		}

		h2 {
			font-size: clamp(1.8rem, 3.5vw, 3rem);
			letter-spacing: -0.03em;
			line-height: 1.15;
			margin-bottom: 0;
		}

		p {
			color: $font-mid;
			font-size: 0.95rem;
			line-height: 1.8;
			margin: 0;
		}
	}

	&__grid {
		display: grid;
		grid-template-columns: 2fr 1.5fr 1.5fr;
		gap: 16px;

		@media (max-width: 900px) {
			grid-template-columns: 1fr;
		}
	}
}

.pillar-card {
	padding: 48px 40px;
	border: 1px solid $border-subtle;
	background: $secondary;
	display: flex;
	flex-direction: column;
	position: relative;
	overflow: hidden;

	&::before {
		content: attr(data-num);
		position: absolute;
		top: -16px;
		right: -6px;
		font-family: "apparat-light", sans-serif;
		font-size: 9rem;
		font-weight: 300;
		color: rgba(35, 61, 37, 0.07);
		line-height: 1;
		pointer-events: none;
		letter-spacing: -0.04em;
	}

	&__eyebrow {
		font-family: "indivisible", sans-serif;
		font-size: 9px;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: $earth-brown;
		margin-bottom: 20px;
	}

	h3 {
		font-size: 1.2rem;
		margin-bottom: 14px;
		color: $green-dark;
	}

	p {
		font-size: 0.9rem;
		line-height: 1.8;
		color: $font-mid;
		flex: 1;
		margin-bottom: 28px;
	}

	&__link {
		font-family: "indivisible", sans-serif;
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: $font-mid;
		text-decoration: none;
		border-bottom: 1px solid $border-subtle;
		padding-bottom: 3px;
		align-self: flex-start;
		transition: color 0.2s ease, border-color 0.2s ease;

		&:hover {
			color: $earth-brown;
			border-color: $earth-warm;
		}
	}
}

// ─────────────────────────────────────────────
// Photo carousel
// ─────────────────────────────────────────────

.image-strip {
	background: $primary;
	padding: 72px 0;
	border-top: 1px solid $border-subtle;

	&__grid {
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		gap: 0;

		@media (max-width: 600px) {
			overflow-x: auto;
			grid-template-columns: repeat(6, minmax(140px, 1fr));
		}
	}

	&__item {
		overflow: hidden;

		img {
			width: 100%;
			height: 480px;
			object-fit: cover;
			object-position: center;
			display: block;
			transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
		}

		&:hover img {
			transform: scale(1.05);
		}

		&__label {
			font-family: "indivisible", sans-serif;
			font-size: 9px;
			text-transform: uppercase;
			letter-spacing: 0.12em;
			color: $green-mid;
			text-align: center;
			padding: 8px 0 0;
		}
	}
}

// ─────────────────────────────────────────────
// Lizard Camp feature
// ─────────────────────────────────────────────

.program-feature {
	background: $secondary;
	overflow: hidden;

	&__inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		min-height: 520px;

		@media (max-width: 820px) {
			grid-template-columns: 1fr;
		}
	}

	&__photo {
		position: relative;
		overflow: hidden;
		min-height: 340px;

		img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			object-position: center;
			display: block;
			transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
		}

		&:hover img {
			transform: scale(1.04);
		}
	}

	&__badge {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		padding: 56px 28px 22px;
		background: linear-gradient(to top, rgba(44,36,22,0.82) 0%, transparent 100%);
		font-family: "indivisible", sans-serif;
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: rgba(247, 243, 238, 0.9);
		text-shadow: 0 1px 6px rgba(14, 10, 6, 0.5);
	}

	&__content {
		padding: 64px 60px;
		display: flex;
		flex-direction: column;
		justify-content: center;

		@media (max-width: 820px) {
			padding: 48px 32px;
		}

		@include respond-to('small-mx') {
			padding: 36px 24px;
		}
	}

	&__label {
		font-family: "indivisible", sans-serif;
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: $green-mid;
		margin-bottom: 14px;
	}

	h2 {
		font-size: 2rem;
		margin-bottom: 18px;
		color: $green-dark;
		line-height: 1.2;
	}

	p {
		font-size: 0.93rem;
		line-height: 1.8;
		color: $font-mid;
		margin-bottom: 36px;
		max-width: 44ch;
	}

	&__stats {
		display: flex;
		gap: 36px;
		margin-bottom: 40px;
		flex-wrap: wrap;

		div {
			strong {
				display: block;
				font-family: "apparat-light", sans-serif;
				font-size: 1.6rem;
				color: $green-dark;
				font-weight: 300;
				line-height: 1;
				margin-bottom: 5px;
			}
			span {
				font-family: "indivisible", sans-serif;
				font-size: 10px;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				color: $font-light;
			}
		}
	}

	&__link {
		font-family: "indivisible", sans-serif;
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: $green-dark;
		border: 1px solid $green-dark;
		padding: 13px 28px;
		display: inline-block;
		align-self: flex-start;
		transition: background 0.22s ease, color 0.22s ease;

		&:hover {
			background: $green-dark;
			color: $text-on-green;
		}
	}
}

// ─────────────────────────────────────────────
// Where We Work
// ─────────────────────────────────────────────

.field-sites {
	background: $primary;
	padding: 88px 24px;
	border-top: 1px solid $border-subtle;

	&__heading {
		text-align: center;
		margin-bottom: 56px;

		h2 {
			color: $green-dark;
			font-size: 1.9rem;
			margin-bottom: 10px;
		}

		p {
			color: $font-mid;
			font-size: 0.92rem;
			max-width: 44ch;
			margin: 0 auto;
		}
	}

	&__photos {
		display: grid;
		grid-template-columns: repeat(11, 1fr);
		gap: 3px;
		margin-bottom: 56px;
		overflow-x: auto;

		@include respond-to('small-mx') {
			grid-template-columns: repeat(11, minmax(130px, 1fr));
			margin-bottom: 40px;
		}
	}

	&__photo-item {
		position: relative;
		height: 240px;
		overflow: hidden;

		img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			object-position: center;
			display: block;
			transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
		}

		&:hover img {
			transform: scale(1.06);
		}

		&__label {
			position: absolute;
			inset: 0;
			display: flex;
			align-items: flex-end;
			padding: 12px 14px;
			background: linear-gradient(to top, rgba(14, 10, 6, 0.7) 0%, transparent 60%);
			opacity: 0;
			transition: opacity 0.3s ease;
			font-family: "indivisible", sans-serif;
			font-size: 9px;
			text-transform: uppercase;
			letter-spacing: 0.12em;
			color: rgba(247, 243, 238, 0.9);
			line-height: 1.4;
		}

		&:hover &__label {
			opacity: 1;
		}
	}

	&__region {
		padding: 0 14px;

		@include respond-to('small-mx') {
			padding: 0;
			margin-bottom: 32px;
		}
	}

	&__region-name {
		font-family: "indivisible", sans-serif;
		font-size: 9px;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		color: $earth-brown;
		margin-bottom: 16px;
		padding-bottom: 12px;
		border-bottom: 1px solid $border-subtle;
	}

	&__sites {
		list-style: none;
		padding: 0;
		margin: 0;

		li {
			font-size: 0.87rem;
			color: $font-mid;
			padding: 6px 0;
			display: flex;
			align-items: baseline;
			gap: 10px;
			font-family: "apparat-light", sans-serif;
			line-height: 1.4;
			border-bottom: 1px solid $border-subtle;

			&:last-child { border-bottom: none; }

			em {
				font-style: normal;
				color: $earth-brown;
				font-family: "indivisible", sans-serif;
				font-size: 9px;
				text-transform: uppercase;
				letter-spacing: 0.08em;
			}
		}
	}
}

// ─────────────────────────────────────────────
// Photo break
// ─────────────────────────────────────────────

.photo-break {
	position: relative;
	height: 55vh;
	min-height: 320px;
	overflow: hidden;

	&__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 30%;
		display: block;
	}

	&__quote {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(
			to bottom,
			rgba(44, 36, 22, 0.08) 0%,
			rgba(44, 36, 22, 0.42) 100%
		);

		p {
			font-family: "apparat-light", sans-serif;
			font-size: 1.5rem;
			font-weight: 300;
			color: #F7F3EE;
			text-align: center;
			max-width: 36ch;
			line-height: 1.5;
			letter-spacing: -0.01em;
			padding: 0 24px;
			margin: 0;
			text-shadow: 0 2px 20px rgba(14, 10, 6, 0.65);

			@include respond-to('small-mx') {
				font-size: 1.15rem;
			}
		}
	}
}

// ─────────────────────────────────────────────
// NETP Callout
// ─────────────────────────────────────────────

.netp-callout {
	background: $surface;
	border-top: 1px solid $border-subtle;
	border-bottom: 1px solid $border-subtle;
	padding: 64px 48px;

	@include respond-to('small-mx') {
		padding: 48px 24px;
	}

	&__inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 80px;
		align-items: center;

		@media (max-width: 768px) {
			grid-template-columns: 1fr;
			gap: 32px;
		}
	}

	&__content {
		.netp-callout__label {
			font-family: "indivisible", sans-serif;
			font-size: 9px;
			text-transform: uppercase;
			letter-spacing: 0.2em;
			color: $earth-brown;
			margin-bottom: 16px;
		}

		h2 {
			font-size: clamp(1.6rem, 2.8vw, 2.4rem);
			margin-bottom: 16px;
			color: $green-dark;
			letter-spacing: -0.02em;
		}

		p {
			font-size: 0.93rem;
			line-height: 1.8;
			color: $font-mid;
			margin-bottom: 28px;
			max-width: 48ch;
		}

		a {
			font-family: "indivisible", sans-serif;
			font-size: 10px;
			text-transform: uppercase;
			letter-spacing: 0.14em;
			color: $font-mid;
			text-decoration: none;
			border-bottom: 1px solid $border-subtle;
			padding-bottom: 3px;
			transition: color 0.2s, border-color 0.2s;

			&:hover {
				color: $earth-brown;
				border-color: $earth-warm;
			}
		}
	}

	&__visual {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2px;

		@media (max-width: 768px) {
			display: none;
		}
	}

	&__stat {
		background: $secondary;
		border: 1px solid $border-subtle;
		padding: 32px 28px;

		strong {
			display: block;
			font-family: "apparat-light", sans-serif;
			font-size: 3rem;
			font-weight: 300;
			color: $green-dark;
			line-height: 1;
			margin-bottom: 6px;
			letter-spacing: -0.03em;
		}

		span {
			font-family: "indivisible", sans-serif;
			font-size: 9px;
			text-transform: uppercase;
			letter-spacing: 0.14em;
			color: $font-light;
			line-height: 1.6;
			display: block;
		}

		&--accent {
			background: $green-dark;

			strong { color: $text-on-green; }
			span { color: rgba(247,243,238,0.5); }
		}
	}
}

// ─────────────────────────────────────────────
// Newsletter strip
// ─────────────────────────────────────────────

.newsletter-strip {
	background: $secondary;
	border-top: 1px solid $border-subtle;
	padding: 64px 24px;
	text-align: center;

	h2 {
		font-size: 1.4rem;
		margin-bottom: 10px;
	}

	&__archive {
		font-family: "indivisible", sans-serif;
		font-size: 10.5px;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: $font-light;
		margin-bottom: 32px !important;

		a {
			color: $green-mid;
			text-decoration: underline;
			text-underline-offset: 3px;
			&:hover { color: $green-dark; }
		}
	}

	p {
		color: $font-mid;
		font-size: 0.9rem;
		max-width: 46ch;
		margin: 0 auto 28px;
	}

	a.newsletter-link {
		font-family: "indivisible", sans-serif;
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 0.09em;
		color: $green-dark;
		border: 1px solid $green-dark;
		padding: 12px 28px;
